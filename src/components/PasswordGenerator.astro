<section class="tool-panel" aria-labelledby="outil-generateur-mot-passe">
  <div class="tool-panel-header">
    <div>
      <p class="eyebrow">Sécurité gratuite</p>
      <h2 id="outil-generateur-mot-passe">Générer un mot de passe</h2>
      <p>
        Créez un mot de passe fort avec longueur personnalisée, chiffres, symboles et lettres en un clic.
      </p>
    </div>
  </div>

  <form class="password-tool" id="password-form">
    <label>
      Longueur
      <input id="password-length" type="range" min="8" max="40" value="18" />
      <span class="range-value"><output id="password-length-output">18</output> caractères</span>
    </label>

    <div class="option-grid">
      <label><input type="checkbox" id="include-uppercase" checked /> Majuscules</label>
      <label><input type="checkbox" id="include-lowercase" checked /> Minuscules</label>
      <label><input type="checkbox" id="include-numbers" checked /> Chiffres</label>
      <label><input type="checkbox" id="include-symbols" checked /> Symboles</label>
    </div>

    <label>
      Mot de passe généré
      <input id="password-output" type="text" readonly value="" aria-live="polite" />
    </label>

    <div class="strength-meter" aria-label="Force du mot de passe">
      <span id="strength-bar"></span>
    </div>
    <p class="message message-neutral" id="password-strength">Prêt à générer un mot de passe.</p>

    <div class="action-row">
      <button class="button" type="button" id="generate-password-button">Générer</button>
      <button class="button button-secondary" type="button" id="copy-password-button">Copier</button>
    </div>
  </form>
</section>

<script>
  const lengthInput = document.querySelector("#password-length");
  const lengthOutput = document.querySelector("#password-length-output");
  const output = document.querySelector("#password-output");
  const strengthLabel = document.querySelector("#password-strength");
  const strengthBar = document.querySelector("#strength-bar");
  const generateButton = document.querySelector("#generate-password-button");
  const copyButton = document.querySelector("#copy-password-button");
  const options = {
    uppercase: document.querySelector("#include-uppercase"),
    lowercase: document.querySelector("#include-lowercase"),
    numbers: document.querySelector("#include-numbers"),
    symbols: document.querySelector("#include-symbols")
  };
  const groups = {
    uppercase: "ABCDEFGHJKLMNPQRSTUVWXYZ",
    lowercase: "abcdefghijkmnopqrstuvwxyz",
    numbers: "23456789",
    symbols: "!@#$%&*?+-_"
  };

  lengthInput?.addEventListener("input", () => {
    lengthOutput.textContent = lengthInput.value;
  });
  generateButton?.addEventListener("click", generatePassword);
  copyButton?.addEventListener("click", copyPassword);
  Object.values(options).forEach((checkbox) => checkbox?.addEventListener("change", generatePassword));

  generatePassword();

  function generatePassword() {
    const selectedGroups = Object.entries(options)
      .filter(([, checkbox]) => checkbox.checked)
      .map(([key]) => groups[key]);

    if (selectedGroups.length === 0) {
      output.value = "";
      updateStrength(0, "Sélectionnez au moins un type de caractère.", "error");
      return;
    }

    const length = Number(lengthInput.value);
    const allChars = selectedGroups.join("");
    const passwordChars = selectedGroups.map((group) => randomChar(group));

    while (passwordChars.length < length) {
      passwordChars.push(randomChar(allChars));
    }

    const password = shuffle(passwordChars).join("");
    output.value = password;
    const score = calculateStrength(password, selectedGroups.length);
    updateStrength(
      score,
      score >= 75 ? "Mot de passe fort." : "Mot de passe correct, augmentez la longueur pour plus de sécurité.",
      score >= 75 ? "success" : "neutral"
    );
  }

  async function copyPassword() {
    if (!output.value) {
      updateStrength(0, "Générez un mot de passe avant de copier.", "error");
      return;
    }

    try {
      await navigator.clipboard.writeText(output.value);
      updateStrength(calculateStrength(output.value, 4), "Mot de passe copié.", "success");
    } catch {
      updateStrength(calculateStrength(output.value, 4), "Impossible de copier automatiquement.", "error");
    }
  }

  function randomChar(chars) {
    const bytes = new Uint32Array(1);
    crypto.getRandomValues(bytes);
    return chars[bytes[0] % chars.length];
  }

  function shuffle(items) {
    const copy = [...items];
    for (let index = copy.length - 1; index > 0; index -= 1) {
      const bytes = new Uint32Array(1);
      crypto.getRandomValues(bytes);
      const swapIndex = bytes[0] % (index + 1);
      [copy[index], copy[swapIndex]] = [copy[swapIndex], copy[index]];
    }
    return copy;
  }

  function calculateStrength(password, groupCount) {
    const lengthScore = Math.min(70, password.length * 3.5);
    const varietyScore = groupCount * 8;
    return Math.min(100, Math.round(lengthScore + varietyScore));
  }

  function updateStrength(score, text, type) {
    strengthBar.style.width = `${score}%`;
    strengthLabel.textContent = text;
    strengthLabel.className = `message message-${type}`;
  }
</script>

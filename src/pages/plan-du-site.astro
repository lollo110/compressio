---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { tools } from "@/data/tools";
import { articles } from "@/data/articles";

const title = "Plan du site";
const description =
  "Plan du site Compressio : retrouvez tous les outils gratuits, guides pratiques et pages importantes du site.";

const mainPages = [
  { href: "/", label: "Accueil" },
  { href: "/outils", label: "Tous les outils" },
  { href: "/blog", label: "Guides pratiques" },
  { href: "/a-propos", label: "À propos" },
  { href: "/contact", label: "Contact" }
];

const legalPages = [
  { href: "/confidentialite", label: "Politique de confidentialité" },
  { href: "/conditions-utilisation", label: "Conditions d'utilisation" },
  { href: "/mentions-legales", label: "Mentions légales" }
];

const availableTools = tools.filter((tool) => tool.status === "available");
const plannedTools = tools.filter((tool) => tool.status === "planned");
---

<BaseLayout title={title} description={description} canonical="/plan-du-site">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Navigation</p>
      <h1>Plan du site</h1>
      <p>
        Accédez rapidement aux outils gratuits, guides SEO et pages utiles de Compressio.
      </p>
    </div>
  </section>

  <section class="content-section">
    <div class="container sitemap-grid">
      <section class="article-box">
        <h2>Pages principales</h2>
        <ul class="link-list">
          {mainPages.map((page) => <li><a class="text-link" href={page.href}>{page.label}</a></li>)}
        </ul>
      </section>

      <section class="article-box">
        <h2>Outils gratuits</h2>
        <ul class="link-list">
          {availableTools.map((tool) => (
            <li>
              <a class="text-link" href={`/outils/${tool.slug}`}>{tool.title}</a>
              <span>{tool.category}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="article-box">
        <h2>Guides pratiques</h2>
        <ul class="link-list">
          {articles.map((article) => (
            <li>
              <a class="text-link" href={`/blog/${article.slug}`}>{article.title}</a>
              <span>{article.category}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="article-box">
        <h2>Pages légales</h2>
        <ul class="link-list">
          {legalPages.map((page) => <li><a class="text-link" href={page.href}>{page.label}</a></li>)}
        </ul>
      </section>

      {plannedTools.length > 0 && (
        <section class="article-box">
          <h2>Outils prévus</h2>
          <ul class="link-list">
            {plannedTools.map((tool) => (
              <li>
                <span>{tool.title}</span>
                <small>{tool.category}</small>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/config/site";

const title = "Mentions légales";
const description =
  "Mentions légales du site Compressio : éditeur, responsable de publication, contact, hébergement et responsabilité.";
---

<BaseLayout title={title} description={description} canonical="/mentions-legales">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Informations</p>
      <h1>Mentions légales</h1>
      <p>
        Informations relatives à l'éditeur, au responsable de publication et à l'hébergement du site Compressio.
      </p>
    </div>
  </section>

  <section class="content-section">
    <div class="container article-box">
      <h2>Éditeur du site</h2>
      <p>Type d'éditeur : particulier.</p>
      <p>Nom : Lorenzo Paolo Cilurzo.</p>
      <p>Adresse postale : non publiée publiquement. Elle peut être communiquée sur demande légitime.</p>
      <p>Email : <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p>

      <h2>Responsable de publication</h2>
      <p>Responsable de publication : Lorenzo Paolo Cilurzo.</p>

      <h2>Site et public ciblé</h2>
      <p>Nom du site : {site.name}.</p>
      <p>Domaine : <a href={site.url}>{site.url}</a>.</p>
      <p>Pays principalement ciblé : France.</p>

      <h2>Hébergement</h2>
      <p>Le site est hébergé par :</p>
      <p>
        Vercel Inc.<br />
        440 N Barranca Ave #4133<br />
        Covina, CA 91723<br />
        United States
      </p>

      <h2>Propriété intellectuelle</h2>
      <p>
        Les textes, interfaces, composants et contenus publiés sur Compressio sont protégés. Toute reproduction non autorisée peut être interdite, sauf mention contraire.
      </p>

      <h2>Responsabilité</h2>
      <p>
        Compressio fournit des outils gratuits et des contenus informatifs. L'utilisateur reste responsable de la vérification des fichiers, calculs et résultats générés.
      </p>

      <h2>Publicité</h2>
      <p>
        Des emplacements publicitaires sont prévus sur certaines pages afin de financer le service gratuit. Les publicités Google AdSense sont prévues mais non activées actuellement.
      </p>
    </div>
  </section>
</BaseLayout>

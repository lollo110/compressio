---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ToolCard from "@/components/ToolCard.astro";
import { tools } from "@/data/tools";

const title = "Tous les outils gratuits";
const description =
  "Découvrez les outils gratuits de Compressio pour optimiser images, PDF et fichiers web directement en ligne.";
---

<BaseLayout title={title} description={description} canonical="/outils">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Catalogue</p>
      <h1>Tous les outils Compressio</h1>
      <p>
        Une base évolutive pour regrouper des outils simples, rapides et monétisables autour de besoins recherchés.
      </p>
    </div>
  </section>
  <section class="content-section">
    <div class="container tools-grid">
      {tools.map((tool) => <ToolCard tool={tool} />)}
    </div>
  </section>
</BaseLayout>
